# Claire Healthcare Robot Interface - Backend Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration (Required for conversation AI)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Jitsi Conferencing (Optional)
JITSI_BASE_URL=https://meet.jit.si
DEFAULT_ROOM=nurse-station

# Optional: Weather Service API key
# Get from: https://openweathermap.org/api
WEATHER_API_KEY=your-weather-api-key

# Optional: News Service API key
# Get from: https://newsapi.org
NEWS_API_KEY=your-newsapi-key

# WebRTC TURN Server Configuration
# For production, use your own TURN server or a service like Twilio/Metered
TURN_SERVER_URL=turn:a.relay.metered.ca:443
TURN_SERVER_USERNAME=your-turn-username
TURN_SERVER_CREDENTIAL=your-turn-credential

# ============================================================================
# SUPABASE CONFIGURATION (Optional - for persistent storage)
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
# If not configured, the app will use in-memory storage (data lost on restart)
# ============================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (for frontend - with RLS)
SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (for backend - bypasses RLS)
# KEEP THIS SECRET - never expose in frontend code
SUPABASE_SERVICE_KEY=your-service-role-key
