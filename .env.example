# Claire Healthcare Robot Interface - Frontend Configuration
# Copy this file to .env and fill in your values

# Backend API (for OpenAI - used by backend, not frontend)
OPENAI_API_KEY=sk-your-api-key-here

# Jitsi Configuration (Optional)
JITSI_BASE_URL=https://meet.jit.si
DEFAULT_ROOM=nurse-station

# ============================================================================
# SUPABASE CONFIGURATION (Optional - for persistent storage)
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
# If not configured, the app will use in-memory storage (data lost on restart)
# ============================================================================

# Supabase Project URL (for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (for frontend - with RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key</content>
<parameter name="filePath">/workspaces/health-robot-interface/.env.example